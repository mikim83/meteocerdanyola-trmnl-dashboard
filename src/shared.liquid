{%- case now.pressure_trend -%}
  {%- when "rising_fast" -%}{%- assign s_trend = s_rising_fast -%}
  {%- when "rising" -%}{%- assign s_trend = s_rising -%}
  {%- when "steady" -%}{%- assign s_trend = s_steady -%}
  {%- when "falling" -%}{%- assign s_trend = s_falling -%}
  {%- when "falling_fast" -%}{%- assign s_trend = s_falling_fast -%}
  {%- else -%}{%- assign s_trend = "—" -%}
{%- endcase -%}


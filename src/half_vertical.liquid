{%- if no_data -%}
<div class="layout layout--col layout--center">
  <span class="title">{{ s_nodata }}</span>
  <span class="description">{{ site.name }} {{ s_nodata_desc }}</span>
</div>
{%- else -%}
<div class="layout layout--col gap--space-between">

  <div class="item">
    <div class="meta"></div>
    <div class="content">
      <span class="label label--small">{{ s_temp_now }} · {{ observed.time }}{% if observed.stale %} ({{ s_delayed }}){% endif %}</span>
      <span class="value value--tnums value--xxlarge" data-value-fit="true">{{ n_temp }}°</span>
      <span class="label">{{ s_feels }} {{ n_feels }}° · {{ s_hum }} {{ now.hum }}%</span>
    </div>
  </div>

  <div class="flex flex--col gap--small">
    <span class="label label--small">{{ s_last24 }} · {{ s_max }} {{ n_tmax }}° · {{ s_min }} {{ n_tmin }}°</span>
    <div id="chart-temp" class="w--full"></div>
  </div>

  <div class="grid grid--cols-2">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label label--small">{{ s_wind }}</span>
        <span class="value value--tnums value--small">{{ now.wind }} km/h</span>
        <span class="label">{{ w_dir }} {{ now.wind_deg }}°{% if now.calm %} · {{ s_calm }}{% endif %}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label label--small">{{ s_pressure }}</span>
        <span class="value value--tnums value--small">{{ now.pressure_int }}</span>
        <span class="label">hPa · {{ s_trend }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label label--small">{{ s_rain }} 24 h</span>
        <span class="value value--tnums value--small">{{ n_rain_24h }} mm</span>
        <span class="label">{{ n_rain_rate }} mm/h</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label label--small">{{ s_dew }}</span>
        <span class="value value--tnums value--small">{{ n_dew }}°</span>
        <span class="label">{{ s_hum }} {{ now.hum }}%</span>
      </div>
    </div>
  </div>

</div>
<script>mcChart('chart-temp', {{ series.temp | json }}, { height: 100, suffix: '°', tick: 8, size: 12, tickAmount: 3 });</script>
{%- endif -%}

<div class="title_bar">
  <img class="image" src="data:image/png;base64,{{ icon_b64 }}">
  <span class="title">meteocerdanyola.com</span>
  <span class="instance">{{ site.name }}</span>
</div>

{%- if no_data -%}
<div class="layout layout--col layout--center">
  <span class="title">{{ s_nodata }}</span>
  <span class="description">{{ site.name }} {{ s_nodata_desc }}</span>
</div>
{%- else -%}
{%- assign chart_id = "chart-" | append_random -%}
<div class="layout layout--col gap--space-between">

  <div class="grid">
    <div class="col gap--small col--span-4">
      <div class="flex flex--row flex--left flex--center-y gap--small">{{ ic_thermo }}<span class="label label--underline">{{ s_temp }}</span></div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--tnums value--xxxlarge" data-value-fit="true">{{ n_temp }}°</span>
          <span class="label">{{ s_feels }} {{ n_feels }}°</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <div class="flex flex--row flex--left flex--center-y gap--small">{{ ic_tmax }}<span class="label">{{ s_max }} 24 h: {{ n_tmax }}° ({{ day.temp_max_time }})</span></div>
          <div class="flex flex--row flex--left flex--center-y gap--small">{{ ic_tmin }}<span class="label">{{ s_min }} 24 h: {{ n_tmin }}° ({{ day.temp_min_time }})</span></div>
        </div>
      </div>
    </div>

    <div class="col col--span-8 gap--small">
      <span class="label label--small">{{ s_last24 }} · {{ s_rain_bars }}</span>
      <div id="{{ chart_id }}" class="w--full"></div>
    </div>
  </div>

  <div class="divider"></div>

  <div class="grid grid--cols-4">
    <div class="col gap--small">
      <div class="flex flex--row flex--left flex--center-y gap--small">{{ ic_wind }}<span class="label label--underline">{{ s_wind }}</span></div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <div class="flex flex--row flex--baseline gap--xsmall"><span class="value value--tnums value--large">{{ now.wind }}</span><span class="label">km/h</span></div>
          <span class="label">{{ w_dir }} {{ now.wind_deg }}°{% if now.calm %} · {{ s_calm }}{% endif %}</span>
          <span class="label">{{ s_gust }} {{ day.wind_max }} km/h</span>
        </div>
      </div>
    </div>

    <div class="col gap--small">
      <div class="flex flex--row flex--left flex--center-y gap--small">{{ ic_drop }}<span class="label label--underline">{{ s_hum }}</span></div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <div class="flex flex--row flex--baseline gap--xsmall"><span class="value value--tnums value--large">{{ now.hum }}</span><span class="label">%</span></div>
          <span class="label">{{ s_dew }} {{ n_dew }}°</span>
        </div>
      </div>
    </div>

    <div class="col gap--small">
      <div class="flex flex--row flex--left flex--center-y gap--small">{{ ic_gauge }}<span class="label label--underline">{{ s_pressure }}</span></div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--tnums value--large">{{ now.pressure_int }}</span>
          <span class="label">hPa · {{ s_trend }} ({{ n_pdelta }})</span>
        </div>
      </div>
    </div>

    <div class="col gap--small">
      <div class="flex flex--row flex--left flex--center-y gap--small">{{ ic_rain }}<span class="label label--underline">{{ s_rain }}</span></div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <div class="flex flex--row flex--baseline gap--xsmall"><span class="value value--tnums value--large">{{ n_rain_24h }}</span><span class="label">mm</span></div>
          <span class="label">{{ s_last24 }}</span>
          <span class="label">{{ s_intensity }} {{ n_rain_rate }} mm/h</span>
        </div>
      </div>
    </div>
  </div>

</div>
<script>mcChart('{{ chart_id }}', {{ series.temp_hourly | json }}, { fill: true, suffix: '°', tick: 6, size: 14, labelEvery: 6, rain: {{ series.rain_hourly | json }} });</script>
{%- endif -%}

<div class="title_bar">
  <img class="image" src="data:image/png;base64,{{ icon_b64 }}">
  <span class="title">meteocerdanyola.com</span>
  <span class="instance">{{ site.name }} · {{ observed.time }}{% if observed.stale %} ({{ s_delayed }}){% endif %}</span>
</div>
